{
  "project": "E-Commerce Platform with SQLite Backend",
  "purpose": "A complete e-commerce solution with user authentication, a customizable product catalog (seeded with apparel, electronics, accessories, footwear, furniture, and groceries), an interactive shopping cart, and mock order checkouts backed by an optimized SQLite schema.",
  "frontend": {
    "pages": [
      {
        "name": "Landing Page",
        "route": "/",
        "description": "Introduces the store, showcases current deals, and highlights categories like Electronics, Footwear, Apparel, Accessories, Furniture, and Groceries."
      },
      {
        "name": "Register",
        "route": "/register",
        "description": "Provides user signup with fields for email, password, first name, and last name."
      },
      {
        "name": "Login",
        "route": "/login",
        "description": "Secures user authentication, storing JWT or session tokens for catalog checkout functions."
      },
      {
        "name": "Product Catalog",
        "route": "/catalog",
        "description": "Displays all seeded products (such as SuperComfort Running Shoes, Wireless Headphones, etc.) with functional filter options by category and keyword search."
      },
      {
        "name": "Product Details",
        "route": "/products/:id",
        "description": "Focuses on item specifications, pricing, stock levels, and features an Add to Cart action."
      },
      {
        "name": "Shopping Cart",
        "route": "/cart",
        "description": "Allows updating of item quantities or removing products. Computes subtotal automatically using accurate floating-point math."
      },
      {
        "name": "Checkout",
        "route": "/checkout",
        "description": "Prompts users for shipping address and simulated card payments to finalize orders."
      },
      {
        "name": "Order History",
        "route": "/orders",
        "description": "Presents dynamic invoices containing purchase totals, tracking states, and purchase-time pricing snapshots."
      }
    ],
    "features": [
      "Client-side product categorization (Footwear, Apparel, Electronics, Accessories, Furniture, Groceries)",
      "Dynamic search filtering on the Catalog page",
      "Robust validation on Register and Checkout forms",
      "Persistent cart state sync with relational endpoints",
      "Mobile-friendly layouts matching standard shopping conventions"
    ]
  },
  "backend": {
    "apis": [
      {
        "method": "POST",
        "path": "/api/auth/register",
        "description": "Creates a new user record in the SQLite database.",
        "request": {
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "email": "string",
            "password": "string",
            "firstName": "string",
            "lastName": "string"
          }
        },
        "response": {
          "status": 201,
          "body": {
            "success": "boolean",
            "message": "string",
            "user": {
              "id": "integer",
              "email": "string",
              "firstName": "string",
              "lastName": "string"
            }
          }
        }
      },
      {
        "method": "POST",
        "path": "/api/auth/login",
        "description": "Verifies credentials, returning a token alongside user status.",
        "request": {
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "email": "string",
            "password": "string"
          }
        },
        "response": {
          "status": 200,
          "body": {
            "success": "boolean",
            "token": "string",
            "user": {
              "id": "integer",
              "email": "string",
              "firstName": "string",
              "lastName": "string",
              "role": "string"
            }
          }
        }
      },
      {
        "method": "GET",
        "path": "/api/products",
        "description": "Retrieves the collection of products filtered optionally by keyword search or category.",
        "request": {
          "query": {
            "search": "string (optional)",
            "category": "string (optional)"
          }
        },
        "response": {
          "status": 200,
          "body": {
            "products": [
              {
                "id": "integer",
                "name": "string",
                "description": "string",
                "price": "real",
                "category": "string",
                "imageUrl": "string",
                "stock": "integer"
              }
            ]
          }
        }
      },
      {
        "method": "GET",
        "path": "/api/products/:id",
        "description": "Fetches standard attributes for a target product ID.",
        "request": {},
        "response": {
          "status": 200,
          "body": {
            "id": "integer",
            "name": "string",
            "description": "string",
            "price": "real",
            "category": "string",
            "imageUrl": "string",
            "stock": "integer"
          }
        }
      },
      {
        "method": "GET",
        "path": "/api/cart",
        "description": "Displays currently selected items for the logged-in user.",
        "request": {
          "headers": {
            "Authorization": "Bearer <token>"
          }
        },
        "response": {
          "status": 200,
          "body": {
            "items": [
              {
                "cartItemId": "integer",
                "productId": "integer",
                "name": "string",
                "price": "real",
                "quantity": "integer",
                "imageUrl": "string"
              }
            ],
            "totalAmount": "real"
          }
        }
      },
      {
        "method": "POST",
        "path": "/api/cart",
        "description": "Appends, merges, or updates quantity configuration of a product in the authenticated user's cart.",
        "request": {
          "headers": {
            "Authorization": "Bearer <token>",
            "Content-Type": "application/json"
          },
          "body": {
            "productId": "integer",
            "quantity": "integer"
          }
        },
        "response": {
          "status": 200,
          "body": {
            "success": "boolean",
            "message": "string"
          }
        }
      },
      {
        "method": "DELETE",
        "path": "/api/cart/:productId",
        "description": "Removes designated product row from the logged-in user's cart selection.",
        "request": {
          "headers": {
            "Authorization": "Bearer <token>"
          }
        },
        "response": {
          "status": 200,
          "body": {
            "success": "boolean",
            "message": "string"
          }
        }
      },
      {
        "method": "POST",
        "path": "/api/orders",
        "description": "Transforms cart records into active invoice schemas, subtracting active stock thresholds.",
        "request": {
          "headers": {
            "Authorization": "Bearer <token>",
            "Content-Type": "application/json"
          },
          "body": {
            "shippingAddress": "string"
          }
        },
        "response": {
          "status": 201,
          "body": {
            "success": "boolean",
            "orderId": "integer",
            "totalAmount": "real"
          }
        }
      },
      {
        "method": "GET",
        "path": "/api/orders",
        "description": "Queries billing events and purchase lists tied directly to the requester token.",
        "request": {
          "headers": {
            "Authorization": "Bearer <token>"
          }
        },
        "response": {
          "status": 200,
          "body": {
            "orders": [
              {
                "orderId": "integer",
                "totalAmount": "real",
                "shippingAddress": "string",
                "status": "string",
                "createdAt": "string",
                "items": [
                  {
                    "productId": "integer",
                    "productName": "string",
                    "quantity": "integer",
                    "priceAtPurchase": "real"
                  }
                ]
              }
            ]
          }
        }
      }
    ]
  },
  "database": {
    "tables": [
      {
        "name": "users",
        "columns": [
          {
            "name": "id",
            "type": "INTEGER PRIMARY KEY AUTOINCREMENT"
          },
          {
            "name": "email",
            "type": "TEXT UNIQUE NOT NULL"
          },
          {
            "name": "password_hash",
            "type": "TEXT NOT NULL"
          },
          {
            "name": "first_name",
            "type": "TEXT NOT NULL"
          },
          {
            "name": "last_name",
            "type": "TEXT NOT NULL"
          },
          {
            "name": "role",
            "type": "TEXT NOT NULL DEFAULT 'customer'"
          },
          {
            "name": "created_at",
            "type": "TIMESTAMP DEFAULT CURRENT_TIMESTAMP"
          }
        ]
      },
      {
        "name": "products",
        "columns": [
          {
            "name": "id",
            "type": "INTEGER PRIMARY KEY AUTOINCREMENT"
          },
          {
            "name": "name",
            "type": "TEXT NOT NULL"
          },
          {
            "name": "description",
            "type": "TEXT"
          },
          {
            "name": "price",
            "type": "REAL NOT NULL"
          },
          {
            "name": "category",
            "type": "TEXT NOT NULL"
          },
          {
            "name": "image_url",
            "type": "TEXT"
          },
          {
            "name": "stock",
            "type": "INTEGER NOT NULL DEFAULT 0"
          },
          {
            "name": "created_at",
            "type": "TIMESTAMP DEFAULT CURRENT_TIMESTAMP"
          }
        ]
      },
      {
        "name": "cart_items",
        "columns": [
          {
            "name": "id",
            "type": "INTEGER PRIMARY KEY AUTOINCREMENT"
          },
          {
            "name": "user_id",
            "type": "INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE"
          },
          {
            "name": "product_id",
            "type": "INTEGER NOT NULL REFERENCES products(id) ON DELETE CASCADE"
          },
          {
            "name": "quantity",
            "type": "INTEGER NOT NULL DEFAULT 1"
          },
          {
            "name": "updated_at",
            "type": "TIMESTAMP DEFAULT CURRENT_TIMESTAMP"
          }
        ]
      },
      {
        "name": "orders",
        "columns": [
          {
            "name": "id",
            "type": "INTEGER PRIMARY KEY AUTOINCREMENT"
          },
          {
            "name": "user_id",
            "type": "INTEGER NOT NULL REFERENCES users(id) ON DELETE RESTRICT"
          },
          {
            "name": "total_amount",
            "type": "REAL NOT NULL"
          },
          {
            "name": "shipping_address",
            "type": "TEXT NOT NULL"
          },
          {
            "name": "status",
            "type": "TEXT NOT NULL DEFAULT 'pending'"
          },
          {
            "name": "created_at",
            "type": "TIMESTAMP DEFAULT CURRENT_TIMESTAMP"
          }
        ]
      },
      {
        "name": "order_items",
        "columns": [
          {
            "name": "id",
            "type": "INTEGER PRIMARY KEY AUTOINCREMENT"
          },
          {
            "name": "order_id",
            "type": "INTEGER NOT NULL REFERENCES orders(id) ON DELETE CASCADE"
          },
          {
            "name": "product_id",
            "type": "INTEGER REFERENCES products(id) ON DELETE SET NULL"
          },
          {
            "name": "quantity",
            "type": "INTEGER NOT NULL"
          },
          {
            "name": "price_at_purchase",
            "type": "REAL NOT NULL"
          }
        ]
      }
    ]
  }
}