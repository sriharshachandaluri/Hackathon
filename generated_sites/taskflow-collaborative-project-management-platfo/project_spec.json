{
  "project": "TaskFlow - Collaborative Project Management Platform",
  "purpose": "A modern, highly-interactive collaborative project and task management system designed to help teams plan, track, and execute work efficiently. It features dynamic Kanban boards, task assignments, real-time-like status updates, comments, and productivity analytics.",
  "frontend": {
    "pages": [
      {
        "name": "Landing & Authentication",
        "route": "/login",
        "description": "Clean, modern welcome screen with login, registration, and password reset capability."
      },
      {
        "name": "Dashboard Overview",
        "route": "/dashboard",
        "description": "High-level summary of active projects, upcoming deadlines, recent activities, and key productivity metrics represented via charts."
      },
      {
        "name": "Project Workspace (Kanban)",
        "route": "/projects/:id",
        "description": "A comprehensive kanban board view of a specific project. Users can drag-and-drop tasks across columns (To Do, In Progress, Review, Done), filter by priority/assignee, and create new tasks."
      },
      {
        "name": "Project Directory",
        "route": "/projects",
        "description": "Grid/List view of all accessible projects with completion bars, member avatars, and creation forms."
      },
      {
        "name": "Team Directory",
        "route": "/teams",
        "description": "Management page for team members, user roles (Admin, Member, Viewer), and invitations."
      },
      {
        "name": "Analytics & Reports",
        "route": "/analytics",
        "description": "Visual insights displaying task completion rates, workload distribution per user, and sprint burn-down simulation charts."
      }
    ],
    "features": [
      "Interactive drag-and-drop Kanban card transitions",
      "Instant task search and multi-tag filtering (by Priority, Tag, Assignee)",
      "Dark mode and accessibility-focused responsive user interface",
      "Interactive inline editing for task details (titles, descriptions, dates)",
      "Real-time UI state synchronization using client-side state managers"
    ]
  },
