  "database": {
    "tables": [
      {
        "name": "users",
        "columns": [
          {
            "name": "id",
            "type": "VARCHAR(50)",
            "constraints": "PRIMARY KEY"
          },
          {
            "name": "email",
            "type": "VARCHAR(255)",
            "constraints": "UNIQUE NOT NULL"
          },
          {
            "name": "password_hash",
            "type": "VARCHAR(255)",
            "constraints": "NOT NULL"
          },
          {
            "name": "first_name",
            "type": "VARCHAR(100)",
            "constraints": ""
          },
          {
            "name": "last_name",
            "type": "VARCHAR(100)",
            "constraints": ""
          },
          {
            "name": "created_at",
            "type": "TIMESTAMP",
            "constraints": "DEFAULT CURRENT_TIMESTAMP"
          }
        ]
      },
      {
        "name": "projects",
        "columns": [
          {
            "name": "id",
            "type": "VARCHAR(50)",
            "constraints": "PRIMARY KEY"
          },
          {
            "name": "name",
            "type": "VARCHAR(255)",
            "constraints": "NOT NULL"
          },
          {
            "name": "description",
            "type": "TEXT",
            "constraints": ""
          },
          {
            "name": "owner_id",
            "type": "VARCHAR(50)",
            "constraints": "FOREIGN KEY REFERENCES users(id)"
          },
          {
            "name": "status",
            "type": "VARCHAR(50)",
            "constraints": "DEFAULT 'active'"
          },
          {
            "name": "created_at",
            "type": "TIMESTAMP",
            "constraints": "DEFAULT CURRENT_TIMESTAMP"
          }
        ]
      },
      {
        "name": "tasks",
        "columns": [
          {
            "name": "id",
            "type": "VARCHAR(50)",
            "constraints": "PRIMARY KEY"
          },
          {
            "name": "project_id",
            "type": "VARCHAR(50)",
            "constraints": "FOREIGN KEY REFERENCES projects(id) ON DELETE CASCADE"
          },
          {
            "name": "title",
            "type": "VARCHAR(255)",
            "constraints": "NOT NULL"
          },
          {
            "name": "description",
            "type": "TEXT",
            "constraints": ""
          },
          {
            "name": "status",
            "type": "VARCHAR(50)",
            "constraints": "DEFAULT 'To Do'"
          },
          {
            "name": "priority",
            "type": "VARCHAR(50)",
            "constraints": "DEFAULT 'Medium'"
          },
          {
            "name": "due_date",
            "type": "DATE",
            "constraints": ""
          },
          {
            "name": "assignee_id",
            "type": "VARCHAR(50)",
            "constraints": "FOREIGN KEY REFERENCES users(id) ON DELETE SET NULL"
          },
          {
            "name": "created_at",
            "type": "TIMESTAMP",
            "constraints": "DEFAULT CURRENT_TIMESTAMP"
          }
        ]
      },
      {
        "name": "comments",
        "columns": [
          {
            "name": "id",
            "type": "VARCHAR(50)",
            "constraints": "PRIMARY KEY"
          },
          {
            "name": "task_id",
            "type": "VARCHAR(50)",
            "constraints": "FOREIGN KEY REFERENCES tasks(id) ON DELETE CASCADE"
          },
          {
            "name": "user_id",
            "type": "VARCHAR(50)",
            "constraints": "FOREIGN KEY REFERENCES users(id)"
          },
          {
            "name": "content",
            "type": "TEXT",
            "constraints": "NOT NULL"
          },
          {
            "name": "created_at",
            "type": "TIMESTAMP",
            "constraints": "DEFAULT CURRENT_TIMESTAMP"
          }
        ]
      },
      {
        "name": "project_members",
        "columns": [
          {
            "name": "project_id",
            "type": "VARCHAR(50)",
            "constraints": "FOREIGN KEY REFERENCES projects(id) ON DELETE CASCADE"
          },
          {
            "name": "user_id",
            "type": "VARCHAR(50)",
            "constraints": "FOREIGN KEY REFERENCES users(id) ON DELETE CASCADE"
          },
          {
            "name": "role",
            "type": "VARCHAR(50)",
            "constraints": "DEFAULT 'Member'"
          },
          {
            "name": "PRIMARY KEY",
            "type": "(project_id, user_id)",
            "constraints": ""
          }
        ]
      }
    ]
  }
}