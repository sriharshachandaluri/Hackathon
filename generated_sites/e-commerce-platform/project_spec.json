{
  "project": "E-Commerce Platform",
  "purpose": "A responsive and secure e-commerce application allowing users to register, log in, browse a dynamic product catalog, manage a shopping cart, and mock purchase items.",
  "frontend": {
    "pages": [
      {
        "name": "Landing/Home Page",
        "route": "/",
        "description": "Displays promotional banners, categories, and featured products with links to the catalog."
      },
      {
        "name": "Register Page",
        "route": "/register",
        "description": "Form for users to sign up with email, password, and personal details."
      },
      {
        "name": "Login Page",
        "route": "/login",
        "description": "Form for existing users to authenticate and receive an access token."
      },
      {
        "name": "Product Catalog Page",
        "route": "/catalog",
        "description": "Browse all available products. Supports keyword search, category filtering, and sorting by price or popularity."
      },
      {
        "name": "Product Detail Page",
        "route": "/products/:id",
        "description": "Displays detailed information about a single product including description, reviews, stock status, and an 'Add to Cart' button."
      },
      {
        "name": "Shopping Cart Page",
        "route": "/cart",
        "description": "Lists all items added to the cart, allowing quantity adjustments and removal. Displays the cart subtotal and a 'Proceed to Checkout' button."
      },
      {
        "name": "Checkout Page",
        "route": "/checkout",
        "description": "A secure form where authenticated users enter shipping/billing info and submit payment (simulated)."
      },
      {
        "name": "Order History Page",
        "route": "/orders",
        "description": "Displays a list of past orders, order dates, totals, and shipment status for the authenticated user."
      }
    ],
    "features": [
      "JWT-based user session persistence",
      "Dynamic catalog filters and instant search",
      "Persistent cart storage (synchronized with backend for logged-in users or fallback to LocalStorage)",
      "Responsive design supporting mobile, tablet, and desktop viewports",
      "Form validation for login, registration, and checkout screens"
    ]
  },
  "backend": {
    "apis": [
      {
        "method": "POST",
        "path": "/api/auth/register",
        "description": "Registers a new user account.",
        "request": {
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "email": "string",
            "password": "string (min 8 characters)",
            "firstName": "string",
            "lastName": "string"
          }
        },
        "response": {
          "status": 201,
          "body": {
            "success": "boolean",
            "message": "string",
            "user": {
              "id": "integer",
              "email": "string",
              "firstName": "string",
              "lastName": "string"
            }
          }
        }
      },
      {
        "method": "POST",
        "path": "/api/auth/login",
        "description": "Authenticates user credentials and returns a JWT token.",
        "request": {
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "email": "string",
            "password": "string"
          }
        },
        "response": {
          "status": 200,
          "body": {
            "success": "boolean",
            "token": "string",
            "user": {
              "id": "integer",
              "email": "string",
              "firstName": "string",
              "lastName": "string"
            }
          }
        }
      },
      {
        "method": "GET",
        "path": "/api/products",
        "description": "Retrieves products catalog with optional query filters.",
        "request": {
          "query": {
            "search": "string (optional)",
            "category": "string (optional)",
            "sort": "string (optional: price_asc, price_desc, newest)",
            "page": "integer (optional)",
            "limit": "integer (optional)"
          }
        },
        "response": {
          "status": 200,
          "body": {
            "products": [
              {
                "id": "integer",
                "name": "string",
                "description": "string",
                "price": "decimal",
                "category": "string",
                "imageUrl": "string",
                "stock": "integer"
              }
            ],
            "totalProducts": "integer",
            "totalPages": "integer",
            "currentPage": "integer"
          }
        }
      },
      {
        "method": "GET",
        "path": "/api/products/:id",
        "description": "Fetches standard details for a specific product.",
        "request": {},
        "response": {
          "status": 200,
          "body": {
            "id": "integer",
            "name": "string",
            "description": "string",
            "price": "decimal",
            "category": "string",
            "imageUrl": "string",
            "stock": "integer"
          }
        }
      },
      {
        "method": "GET",
        "path": "/api/cart",
        "description": "Fetches the current user's shopping cart.",
        "request": {
          "headers": {
            "Authorization": "Bearer <token>"
          }
        },
        "response": {
          "status": 200,
          "body": {
            "cartItems": [
              {
                "id": "integer",
                "productId": "integer",
                "productName": "string",
                "price": "decimal",
                "quantity": "integer",
                "imageUrl": "string"
              }
            ],
            "subtotal": "decimal"
          }
        }
      },
      {
        "method": "POST",
        "path": "/api/cart",
        "description": "Adds or updates an item in the user's shopping cart.",
        "request": {
          "headers": {
            "Authorization": "Bearer <token>",
            "Content-Type": "application/json"
          },
          "body": {
            "productId": "integer",
            "quantity": "integer"
          }
        },
        "response": {
          "status": 200,
          "body": {
            "success": "boolean",
            "message": "string"
          }
        }
      },
      {
        "method": "DELETE",
        "path": "/api/cart/:productId",
        "description": "Removes an item from the cart entirely.",
        "request": {
          "headers": {
            "Authorization": "Bearer <token>"
          }
        },
        "response": {
          "status": 200,
          "body": {
            "success": "boolean",
            "message": "string"
          }
        }
      },
      {
        "method": "POST",
        "path": "/api/orders",
        "description": "Converts items in cart to a finalized purchase order.",
        "request": {
          "headers": {
            "Authorization": "Bearer <token>",
            "Content-Type": "application/json"
          },
          "body": {
            "shippingAddress": "string",
            "paymentDetails": {
              "cardNumber": "string",
              "expiry": "string",
              "cvv": "string"
            }
          }
        },
        "response": {
          "status": 201,
          "body": {
            "success": "boolean",
            "orderId": "integer",
            "totalAmount": "decimal",
            "status": "string"
          }
        }
      },
      {
        "method": "GET",
        "path": "/api/orders",
        "description": "Fetches order history list for the authenticated user.",
        "request": {
          "headers": {
            "Authorization": "Bearer <token>"
          }
        },
        "response": {
          "status": 200,
          "body": {
            "orders": [
              {
                "orderId": "integer",
                "date": "string (ISO)",
                "totalAmount": "decimal",
                "status": "string",
                "items": [
                  {
                    "productId": "integer",
                    "productName": "string",
                    "quantity": "integer",
                    "priceAtPurchase": "decimal"
                  }
                ]
              }
            ]
          }
        }
      }
    ]
  },
  "database": {
    "tables": [
      {
        "name": "users",
        "columns": [
          {
            "name": "id",
            "type": "SERIAL PRIMARY KEY"
          },
          {
            "name": "email",
            "type": "VARCHAR(255) UNIQUE NOT NULL"
          },
          {
            "name": "password_hash",
            "type": "VARCHAR(255) NOT NULL"
          },
          {
            "name": "first_name",
            "type": "VARCHAR(100) NOT NULL"
          },
          {
            "name": "last_name",
            "type": "VARCHAR(100) NOT NULL"
          },
          {
            "name": "role",
            "type": "VARCHAR(50) DEFAULT 'customer'"
          },
          {
            "name": "created_at",
            "type": "TIMESTAMP DEFAULT CURRENT_TIMESTAMP"
          }
        ]
      },
      {
        "name": "products",
        "columns": [
          {
            "name": "id",
            "type": "SERIAL PRIMARY KEY"
          },
          {
            "name": "name",
            "type": "VARCHAR(255) NOT NULL"
          },
          {
            "name": "description",
            "type": "TEXT"
          },
          {
            "name": "price",
            "type": "DECIMAL(10, 2) NOT NULL"
          },
          {
            "name": "category",
            "type": "VARCHAR(100) NOT NULL"
          },
          {
            "name": "image_url",
            "type": "VARCHAR(500)"
          },
          {
            "name": "stock",
            "type": "INTEGER DEFAULT 0"
          },
          {
            "name": "created_at",
            "type": "TIMESTAMP DEFAULT CURRENT_TIMESTAMP"
          }
        ]
      },
      {
        "name": "cart_items",
        "columns": [
          {
            "name": "id",
            "type": "SERIAL PRIMARY KEY"
          },
          {
            "name": "user_id",
            "type": "INTEGER REFERENCES users(id) ON DELETE CASCADE"
          },
          {
            "name": "product_id",
            "type": "INTEGER REFERENCES products(id) ON DELETE CASCADE"
          },
          {
            "name": "quantity",
            "type": "INTEGER NOT NULL DEFAULT 1"
          },
          {
            "name": "updated_at",
            "type": "TIMESTAMP DEFAULT CURRENT_TIMESTAMP"
          }
        ]
      },
      {
        "name": "orders",
        "columns": [
          {
            "name": "id",
            "type": "SERIAL PRIMARY KEY"
          },
          {
            "name": "user_id",
            "type": "INTEGER REFERENCES users(id) ON DELETE RESTRICT"
          },
          {
            "name": "total_amount",
            "type": "DECIMAL(10, 2) NOT NULL"
          },
          {
            "name": "shipping_address",
            "type": "TEXT NOT NULL"
          },
          {
            "name": "status",
            "type": "VARCHAR(50) DEFAULT 'pending'"
          },
          {
            "name": "created_at",
            "type": "TIMESTAMP DEFAULT CURRENT_TIMESTAMP"
          }
        ]
      },
      {
        "name": "order_items",
        "columns": [
          {
            "name": "id",
            "type": "SERIAL PRIMARY KEY"
          },
          {
            "name": "order_id",
            "type": "INTEGER REFERENCES orders(id) ON DELETE CASCADE"
          },
          {
            "name": "product_id",
            "type": "INTEGER REFERENCES products(id)"
          },
          {
            "name": "quantity",
            "type": "INTEGER NOT NULL"
          },
          {
            "name": "price_at_purchase",
            "type": "DECIMAL(10, 2) NOT NULL"
          }
        ]
      }
    ]
  }
}